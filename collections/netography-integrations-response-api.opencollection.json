            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Tests the supplied Response Integration configuration."
        },
        {
          "info": {
            "name": "Fetch Response Integration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.netography.com/api/v1/integrations/response/:id",
            "params": [
              {
                "name": "id",
                "value": "",
