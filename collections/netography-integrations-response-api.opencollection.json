                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the response integration to be updated"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a response integration given the provided object.  This does not do a diff.  You must send the complete object."
        },
        {
          "info": {
            "name": "Delete Response Integration",
            "type": "http"
