          },
          "docs": "Deletes threshold overrides for the specified object."
        },
        {
          "info": {
            "name": "List Threshold Overrides for Algorithm and Object",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.netography.com/api/v1/rule-engine/triggers/algorithms/:algorithm/objects/:object",
